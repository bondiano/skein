{
	"schemaVersion": 1,
	"id": "mymod",
	"version": "${version}",
	"name": "My Mod",
	"description": "A Fabric mod written in Clojure with Skein.",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"adapter": "clojure",
				"value": "mymod.core/init"
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": ">=26.1",
		"skein": "*",
		"fabric-api": "*"
	}
}
