{;; defmixin bodies use deftype-style method heads (inject, tickServer,
 ;; the arg vector) that are data to the macro, not resolvable symbols.
 :linters {:unresolved-symbol {:exclude [(skein.mixin/defmixin)]}}
 ;; defstate defines a var holding the state's atom, exactly like def.
 :lint-as {skein.state/defstate clojure.core/def}}
